{
  "name": "nuxt-api-shield",
  "version": "2.0.0",
  "description": "Nuxt API Shield - Rate Limiting",
  "repository": "rrd108/nuxt-api-shield",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "security",
    "rate-limit",
    "bruteforce"
  ],
  "exports": {
    ".": {
      "import": "./dist/module.mjs",
      "types": "./dist/index.d.mts"
    },
    "./config": {
      "import": "./dist/config.mjs",
      "types": "./dist/config.d.mts"
    },
    "./types": {
      "types": "./dist/index.d.mts"
    }
  },
  "main": "./dist/module.mjs",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build && node scripts/generate-types.js",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "yarn dev:prepare && vitest run --testTimeout 15000 --reporter=default --reporter.summary=false --disable-console-intercept && yarn test:types",
    "test:watch": "vitest watch  --testTimeout 15000 --reporter=default --reporter.summary=false --disable-console-intercept",
    "test:types": "vue-tsc --noEmit --project ./test/tsconfig.json --moduleResolution bundler"
  },
  "dependencies": {
    "@nuxt/kit": "^4.7.0",
    "c12": "^3.3.4",
    "defu": "^6.1.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "^4.2.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.7.0",
    "@nuxt/test-utils": "^4.4.0",
    "@types/node": "^22.20.5",
    "changelogen": "^0.6.2",
    "eslint": "^10.15.0",
    "nuxi": "^4.1.0",
    "nuxt": "^4.7.0",
    "typescript": "~7.0.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "resolutions": {
    "typescript": "~7.0.0"
  }
}
